<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>mavibank-api-0001</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Marten" />
        <PackageReference Include="Marten.Newtonsoft" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="Scrutor" />
        <PackageReference Include="WolverineFx" />
        <PackageReference Include="WolverineFx.RuntimeCompilation" />
        <PackageReference Include="WolverineFx.Http" />
        <PackageReference Include="WolverineFx.Marten" />
        <PackageReference Include="WolverineFx.Postgresql" />
        <PackageReference Include="WolverineFx.RabbitMQ" />
        <PackageReference Include="Asp.Versioning.Http" />
    </ItemGroup>

    <ItemGroup>
        <!-- Seed (Merchant/Card) startup'ta embedded JSON olarak okunur (BinCardSeeder deseni). -->
        <Content Remove="Domains/Merchants/merchant-seed.json" />
        <EmbeddedResource Include="Domains/Merchants/merchant-seed.json" />
        <Content Remove="Domains/Cards/card-seed.json" />
        <EmbeddedResource Include="Domains/Cards/card-seed.json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\aspire\ServiceDefaults\ServiceDefaults.csproj" />
        <ProjectReference Include="..\..\others\Common\Common.csproj" />
    </ItemGroup>

</Project>
