<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire (dev orkestrasyon: Postgres + RabbitMQ) -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.3.5" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.3.5" />
    <!-- Critter Stack -->
    <PackageVersion Include="Marten" Version="9.5.0" />
    <PackageVersion Include="Marten.Newtonsoft" Version="9.5.0" />
    <PackageVersion Include="WolverineFx" Version="6.4.1" />
    <PackageVersion Include="WolverineFx.Http" Version="6.4.1" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.4.1" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.4.1" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.4.1" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.4.1" />
    <!-- API + DI + doküman -->
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.10" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- ServiceDefaults (telemetri + resilience + service discovery) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.2.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.6.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.15.1" />
    <!-- Test -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>
</Project>
